# All three devices use the same server address and the same owner workspace.
EPISUITE_PORT=3210
# Elysium publishes on the LAN and connects to the cloudflaretun Docker network.
# Set 127.0.0.1 here if access should go exclusively through the reverse proxy.
EPISUITE_BIND_ADDRESS=0.0.0.0
# Optional bearer token for /api/v1/day; configure the same token in Zepp.
EPISUITE_WATCH_TOKEN=
# Docker: absolute host path to a mounted separate disk or network backup folder.
# Empty uses a dedicated Docker backup volume. The node user must be able to write it.
EPISUITE_BACKUP_PATH=
# Direct Node startup can set EPISUITE_BACKUP_DIR to a destination directory.
# Used only when creating a new workspace. Later, change it in Settings.
EPISUITE_TIMEZONE=Africa/Cairo
# Optional: reachable from inside the container. Ollama must listen on that address.
EPISUITE_OLLAMA_URL=http://host.docker.internal:11434/api/generate
