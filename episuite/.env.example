# All three devices use the same server address and the same owner workspace.
EPISUITE_PORT=3210
EPISUITE_BIND_ADDRESS=0.0.0.0
# Used only when creating a new workspace. Later, change it in Settings.
EPISUITE_TIMEZONE=Africa/Cairo
# Optional: reachable from inside the container. Ollama must listen on that address.
EPISUITE_OLLAMA_URL=http://host.docker.internal:11434/api/generate
